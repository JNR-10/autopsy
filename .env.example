# --- Capture (LensConfig) ---

# Session storage (default: ~/.autopsy/sessions or first writable fallback)
# AUTOPSY_SESSION_DIR=~/.autopsy/sessions

# Sampling: all | errors | off | 0.0-1.0 head-rate
AUTOPSY_SAMPLE=errors

# Detectors: comma-separated names or off
# AUTOPSY_DETECTORS=empty_response,tool_loop,missing_output
AUTOPSY_TOOL_LOOP_THRESHOLD=5
AUTOPSY_MAX_TOOL_CALLS=50
# AUTOPSY_PROMOTE_ON_WARN=0

# Writer / retention
# AUTOPSY_FLUSH_BATCH_SIZE=100
# AUTOPSY_QUEUE_MAXSIZE=10000
# AUTOPSY_MAX_TOTAL_DISK_MB=2048
# AUTOPSY_MAX_SESSION_AGE_DAYS=30

# --- Diagnose (DiagnoseConfig) ---

# GMI Cloud — https://gmi.ai/console
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_DEFAULT_MODEL=deepseek-ai/DeepSeek-V3.2
GMI_FALLBACK_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct

# Google AI Studio — https://aistudio.google.com
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Provider selection: auto | gmi | gemini | heuristic
# AUTOPSY_DIAGNOSE_MODEL=auto
# AUTOPSY_DIAGNOSE_TOKEN_THRESHOLD=32000
# AUTOPSY_GMI_TIMEOUT=10
# AUTOPSY_GEMINI_TIMEOUT=60

# --- Server / demo ---

AUTOPSY_PORT=7823
AUTOPSY_HOST=127.0.0.1
# AUTOPSY_NO_BROWSER=1

# Demo scripts only
# AUTOPSY_LOOP_DELAY_S=8
# AUTOPSY_DEMO_MODE=broken
# AUTOPSY_LATENCY_SCALE=2.5
