# --- Capture (LensConfig) ---

# Session storage (default: ~/.autopsy/sessions or first writable fallback)
# AUTOPSY_SESSION_DIR=~/.autopsy/sessions

# Sampling: all | errors | off | 0.0-1.0 head-rate
AUTOPSY_SAMPLE=errors

# Detectors: comma-separated names or off (default: 12 built-ins, see autopsy detectors --list)
# AUTOPSY_DETECTORS=off
# Optional warn-tier: high_latency,error_storm
# AUTOPSY_DETECTOR_PROFILE=balanced
# strict | balanced | lenient — thresholds + buffer sizes (strict sets promote_on_warn=1)
# AUTOPSY_PROMOTE_ON_WARN=1
AUTOPSY_TOOL_LOOP_THRESHOLD=5
AUTOPSY_MAX_TOOL_CALLS=50
# AUTOPSY_LATENCY_THRESHOLD_MS=30000
# AUTOPSY_DUPLICATE_TOOL_THRESHOLD=3
# AUTOPSY_ERROR_STORM_THRESHOLD=3
# AUTOPSY_PROMOTE_ON_WARN=0

# Writer / retention
# AUTOPSY_FLUSH_BATCH_SIZE=100
# AUTOPSY_QUEUE_MAXSIZE=10000
# AUTOPSY_MAX_TOTAL_DISK_MB=2048
# AUTOPSY_MAX_SESSION_AGE_DAYS=30

# --- Diagnose (DiagnoseConfig) ---

# Provider selection: auto | heuristic | openai | anthropic | gmi | gemini | ollama
# AUTOPSY_DIAGNOSE_MODEL=auto
# AUTOPSY_DIAGNOSE_TOKEN_THRESHOLD=32000

# OpenAI (also used by GMI via OpenAI-compatible API)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GMI Cloud — https://gmi.ai/console
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_DEFAULT_MODEL=deepseek-ai/DeepSeek-V3.2
GMI_FALLBACK_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct

# Google AI Studio — https://aistudio.google.com
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Local Ollama (no API key; requires running ollama serve)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Timeouts (seconds)
# AUTOPSY_OPENAI_TIMEOUT=60
# AUTOPSY_ANTHROPIC_TIMEOUT=60
# AUTOPSY_GMI_TIMEOUT=10
# AUTOPSY_GEMINI_TIMEOUT=60
# AUTOPSY_OLLAMA_TIMEOUT=120

# --- Server / demo (optional: pip install autopsy[server]) ---

AUTOPSY_PORT=7823
AUTOPSY_HOST=127.0.0.1
# AUTOPSY_NO_BROWSER=1

# Demo routes (/api/demo/*) — enabled automatically by `autopsy run`
# AUTOPSY_DEMO=0

# Demo scripts only (see examples/)
# AUTOPSY_LOOP_DELAY_S=8
# AUTOPSY_DEMO_MODE=broken
# AUTOPSY_LATENCY_SCALE=2.5
